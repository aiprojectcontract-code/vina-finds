  return `<!DOCTYPE html><html lang="id"><head><meta charset="utf-8"><title>Invoice ${esc(o.po)}</title><style>${css}</style></head><body><div class="np"><button onclick="print()">Cetak / Simpan sebagai PDF</button><div style="color:#5f7694;font-size:13px;margin-top:6px">Di jendela cetak, pilih tujuan "Simpan sebagai PDF".</div></div><div class="pg">
  <div class="h"><div class="br"><img src="${esc(logo)}" alt=""><div><b>VINA FINDS</b><small>Into The Blue | Dive Equipment</small>${sv('address')?`<small>${esc(sv('address'))}</small>`:''}${sv('wa')?`<small>WhatsApp ${esc(sv('wa'))}</small>`:''}</div></div><div class="iv"><h1>INVOICE</h1><div>${esc(o.po)}</div><div style="color:#5f7694;font-size:13px">${dfmt(o.date)}</div><span class="st">${esc(sl.toUpperCase())}</span></div></div>
  <div style="margin-top:16px"><small style="color:#5f7694">Kepada</small><div style="font-weight:700;font-size:16px">${esc(o.name)}</div><div style="color:#5f7694">WhatsApp ${esc(o.wa)}</div></div>
  <table><tr><th>Barang</th><th class="r">Harga</th><th class="r">Qty</th><th class="r">Subtotal</th></tr>${(o.items||[]).map(i=>`<tr><td>${esc(i.name)}${i.size?` <small style="color:#5f7694">(Ukuran ${esc(i.size)})</small>`:''}</td><td class="r">${rz(i.price)}</td><td class="r">${i.qty}</td><td class="r">${rz(i.price*i.qty)}</td></tr>`).join('')}
  <tr class="tt"><td colspan="3" class="r"><b>Total</b></td><td class="r"><b>${rz(t)}</b></td></tr>${paid>0?`<tr class="tt"><td colspan="3" class="r">Sudah dibayar</td><td class="r">${rz(paid)}</td></tr><tr class="tt"><td colspan="3" class="r"><b>Sisa tagihan</b></td><td class="r"><b>${rz(Math.max(0,t-paid))}</b></td></tr>`:''}</table>
  <div class="bx"><h3>Pembayaran</h3><div>DP ${pct}% yang harus dibayar:</div><div class="dp">${rz(dp)}</div><div style="color:#5f7694;font-size:13px;margin-top:4px">Sisa pelunasan setelah DP: ${rz(t-dp)}${paid>0&&paid<dp?` · Kekurangan DP: ${rz(dp-paid)}`:''}</div></div>
