  ${(o.payments||[]).length?`<div class="bx"><h3>Riwayat pembayaran</h3>${o.payments.map(p=>`<div style="display:flex;justify-content:space-between;font-size:14px"><span>${dfmt(p.date)}${p.note?' – '+esc(p.note):''}</span><b>${rz(p.amount)}</b></div>`).join('')}</div>`:''}
  <div class="n">${tgt?`Estimasi tiba di Indonesia: <b>${dfmt(tgt+'T12:00:00+07:00')}</b><br>`:''}${esc(note||'')}</div></div></body></html>`;
}
function ocsv(){
  const rows=[['No. PO','Tanggal','Nama','WhatsApp','Barang','Total','Dibayar','Status bayar','Tahap']].concat(OD.map(o=>[o.po,new Date(o.date).toISOString().slice(0,10),o.name,o.wa,(o.items||[]).map(i=>`${i.name}${i.size?' ('+i.size+')':''} x${i.qty}`).join('; '),oTotal(o),oPaid(o),oStat(o)[0],STG[o.stage]||o.stage]));
  return '\uFEFF'+rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\r\n');
}
const dl=(name,text,type)=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type}));a.download=name;a.click()};
document.addEventListener('click',async e=>{
  const t=e.target,g=a=>t.closest('['+a+']'),er=m=>{const x=$('#oer');if(x)x.textContent=m};
  if(t.id==='odrs'){const v=$('#odr').value.trim();if(!v.includes('/')){$('#odm').textContent='Tulis dengan format pemilik/nama-repository.';return}CFG.dataRepo=v;localStorage.setItem('vf_gh',JSON.stringify(CFG));OLOAD=false;ordTab();return}
  if(t.id==='odrt'){OLOAD=false;ordTab();return}
  if(t.id==='odrc'){CFG.dataRepo='';localStorage.setItem('vf_gh',JSON.stringify(CFG));ordTab();return}
  if(g('data-onew')){oform();return}
  if(g('data-odet')){odet(g('data-odet').dataset.odet);return}
  if(g('data-ocl')){$('#ov').classList.remove('on');return}
  if(g('data-oadd')){$('#ois').insertAdjacentHTML('beforeend',ORow());return}
  if(g('data-orm')){if(document.querySelectorAll('#ois .oi').length>1){g('data-orm').closest('.oi').remove();otot()}return}
  if(g('data-oparse')){
    const r=parseWA($('#owa').value);
    if(!r.items.length&&!r.name&&!r.po){er('Pesan tidak dikenali. Pastikan memakai pesan dari website (berisi No. PO, Nama, dan daftar barang).');return}
    if(r.name)$('#onm').value=r.name;if(r.wa)$('#owp').value=r.wa;if(r.po)$('#opo').value=r.po;
    if(r.items.length){$('#ois').innerHTML=r.items.map(()=>ORow()).join('');document.querySelectorAll('#ois .oi').forEach((row,i)=>{const it=r.items[i];row.querySelector('.on').value=it.name;row.querySelector('.os').value=it.size;row.querySelector('.oq').value=it.qty;row.querySelector('.op').value=it.price})}
    otot();er('');return}
  if(g('data-osave')){osave();return}
  if(g('data-oedit')){oform(g('data-oedit').dataset.oedit);return}
  if(g('data-odel')){const id=g('data-odel').dataset.odel;if(!confirm('Hapus pesanan ini? Tidak bisa dibatalkan.'))return;const bak=JSON.stringify(OD);OD=OD.filter(x=>String(x.id)!==id);try{await saveOrders();$('#ov').classList.remove('on');drawOrders()}catch(x){OD=JSON.parse(bak);er(x.message||String(x))}return}
  if(g('data-opay')){
    const o=OD.find(x=>String(x.id)===g('data-opay').dataset.opay),a=+$('#opa').value;if(!(a>0)){er('Isi jumlah pembayaran.');return}
    const bak=JSON.stringify(OD);(o.payments=o.payments||[]).push({date:new Date().toISOString(),amount:a,note:$('#opn').value.trim()});
    try{await saveOrders();drawOrders();odet(o.id)}catch(x){OD=JSON.parse(bak);er(x.message||String(x))}return}
  if(g('data-opdel')){
    const [id,k]=g('data-opdel').dataset.opdel.split(':'),o=OD.find(x=>String(x.id)===id);if(!confirm('Hapus catatan pembayaran ini?'))return;
    const bak=JSON.stringify(OD);o.payments.splice(+k,1);
    try{await saveOrders();drawOrders();odet(o.id)}catch(x){OD=JSON.parse(bak);er(x.message||String(x))}return}
  if(g('data-ost')){
    const o=OD.find(x=>String(x.id)===g('data-ost').dataset.ost),bak=JSON.stringify(OD);o.stage=NXT[o.stage];
    try{await saveOrders();drawOrders();odet(o.id)}catch(x){OD=JSON.parse(bak);er(x.message||String(x))}return}
  if(g('data-oinv')){
    const o=OD.find(x=>String(x.id)===g('data-oinv').dataset.oinv);
    const w=window.open(URL.createObjectURL(new Blob([invoiceHtml(o)],{type:'text/html'})),'_blank');
    if(!w)er('Browser memblokir jendela baru. Izinkan pop-up untuk situs ini.');return}
  if(g('data-ocsv')){dl('pesanan-vina-finds.csv',ocsv(),'text/csv;charset=utf-8');return}
  if(g('data-ojson')){dl('cadangan-pesanan.json',JSON.stringify({orders:OD},null,1),'application/json');return}
});
document.addEventListener('input',e=>{
  const t=e.target;
  if(t.id==='oq'){OF.q=t.value;drawOrders();const i=$('#oq');i.focus();i.setSelectionRange(i.value.length,i.value.length);return}
  if(t.classList.contains('on')){const p=PJ.P.find(x=>nk(x.name)===nk(t.value));if(p){const r=t.closest('.oi'),pr=r.querySelector('.op');if(!pr.value&&eff(p)>0)pr.value=eff(p);if(p.sizes&&p.sizes.length)r.querySelector('.os').placeholder='Ukuran: '+p.sizes.join(' / ')}otot();return}
  if(t.classList.contains('oq')||t.classList.contains('op'))otot();
});
document.addEventListener('change',e=>{if(e.target.id==='ost'){OF.st=e.target.value;drawOrders()}});
/* ---------- Mulai ---------- */
(async()=>{
  if(!CFG)return setup();
  $('#app').innerHTML='<div class="login"><p class="mu">Memuat data…</p></div>';
  try{await loadAll();shell()}catch(e){setup(e.message||String(e))}
})();
</script></body></html>
